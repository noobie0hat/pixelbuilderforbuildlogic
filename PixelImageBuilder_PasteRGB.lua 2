local RayParams=RaycastParams.new()
RayParams.FilterType=Enum.RaycastFilterType.Exclude
RayParams.IgnoreWater=true

local function RefreshRayFilter()
	local Filter={PosPreview,Gui}
	local Char=Player.Character
	if Char then
		table.insert(Filter,Char)
	end
	RayParams.FilterDescendantsInstances=Filter
end

local function ScreenToWorldHit(ScreenX,ScreenY)
	local Cam=workspace.CurrentCamera
	if not Cam then
		return nil,nil
	end

	RefreshRayFilter()

	local Ray=Cam:ViewportPointToRay(ScreenX,ScreenY)
	local Result=workspace:Raycast(
		Ray.Origin,
		Ray.Direction*2000,
		RayParams
	)

	if not Result then
		-- fallback: plane di Y origin (baseplate area)
		local Origin=GetOriginPosition()
		local T=(Origin.Y-Ray.Origin.Y)/Ray.Direction.Y
		if T and T>0 then
			local P=Ray.Origin+Ray.Direction*T
			return P,nil
		end
		return nil,nil
	end

	return Result.Position,Result
end

local function WorldHitToGrid(WorldPos,RayResult)
	if not WorldPos then
		return nil
	end

	local Pos=WorldPos

	-- Klik surface atas → cell di atas permukaan
	if RayResult and RayResult.Normal then
		local N=RayResult.Normal
		if N.Y>0.7 then
			Pos=Pos+Vector3.new(0,GRANDEUR_BLOC*0.15,0)
		elseif N.Y<-0.7 then
			Pos=Pos-Vector3.new(0,GRANDEUR_BLOC*0.15,0)
		end
	end

	local Grid=PosMonde2Grille(Pos)

	-- Baseplate Y-1 → force Y=0
	if Grid.Y<0 then
		Grid=Vector3.new(Grid.X,0,Grid.Z)
	end

	local X=math.clamp(math.floor(Grid.X),0,255)
	local Y=math.clamp(math.floor(Grid.Y),0,255)
	local Z=math.clamp(math.floor(Grid.Z),0,255)

	return Vector3.new(X,Y,Z)
end

local function GetGridFromScreen(ScreenX,ScreenY)
	local World,Result=ScreenToWorldHit(ScreenX,ScreenY)
	return WorldHitToGrid(World,Result)
end

local function GetGridFromPointer()
	if LastPointerScreen then
		return GetGridFromScreen(
			LastPointerScreen.X,
			LastPointerScreen.Y
		)
	end

	-- Fallback mouse (PC)
	local Loc=UserInputService:GetMouseLocation()
	return GetGridFromScreen(Loc.X,Loc.Y)
end

