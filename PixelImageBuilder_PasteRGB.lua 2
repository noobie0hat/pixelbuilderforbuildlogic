local function Position2CodePosition(
	Position
)

	local X=
		math.floor(
			tonumber(Position.X)
			or
			-1
		)

	local Y=
		math.floor(
			tonumber(Position.Y)
			or
			-1
		)

	local Z=
		math.floor(
			tonumber(Position.Z)
			or
			-1
		)

	if
		X<0
		or
		X>=256
		or
		Y<0
		or
		Y>=256
		or
		Z<0
		or
		Z>=256
	then

		return nil

	end

	local Buffer=
		BitBuffer:Create()

	Buffer:WriteUnsigned(
		8,
		X
	)

	Buffer:WriteUnsigned(
		8,
		Y
	)

	Buffer:WriteUnsigned(
		8,
		Z
	)

	return
		Buffer:ToBase64()

end

