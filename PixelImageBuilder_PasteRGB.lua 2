local function SafeRun(Name,Fn,...)
	local OK,Err=pcall(Fn,...)
	if not OK then
		warn("[PixelBuilder] "..Name.." ERROR: "..tostring(Err))
		Building=false
		Playing=false
		Scanning=false
		Deleting=false
		StopRequested=false
		PlayBadAppleButton.Text="PLAY BAD APPLE"
		PlayRGBButton.Text="RENDER RGB IMAGE"
		PlayCustomBAButton.Text="PLAY CUSTOM BA"
		Status.Text="ERROR "..Name..": "..string.sub(tostring(Err),1,80)
	end
end

