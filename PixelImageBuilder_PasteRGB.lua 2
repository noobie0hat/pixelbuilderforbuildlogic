local function MathRound(Value)

	return math.floor(
		Value+0.5
	)

end

-- Jangan cache PosOrigin sekali di load — bisa stale.
local function GetOriginPosition()
	return PosOriginPart.Position
end

local function PosMonde2Grille(
	WorldPosition
)

	local OriginPosition=GetOriginPosition()

	local X=
		MathRound(
			(
				WorldPosition.X-
				OriginPosition.X
			)/
			GRANDEUR_BLOC
		)

	local Y=
		MathRound(
			(
				WorldPosition.Y-
				OriginPosition.Y
			)/
			GRANDEUR_BLOC
		)

	local Z=
		MathRound(
			(
				WorldPosition.Z-
				OriginPosition.Z
			)/
			GRANDEUR_BLOC
		)

	return Vector3.new(
		X,
		Y,
		Z
	)

end

local function GridToWorld(X,Y,Z)

	local OriginPosition=GetOriginPosition()

	return
		OriginPosition+
		Vector3.new(
			X*GRANDEUR_BLOC,
			Y*GRANDEUR_BLOC,
			Z*GRANDEUR_BLOC
		)

end

