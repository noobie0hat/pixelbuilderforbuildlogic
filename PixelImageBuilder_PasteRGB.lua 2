local function PlaceBlock(Data)

	local OK,Result=
		pcall(function()

			return
				PlacerBloc:InvokeServer(
					BLOCK_ID,
					Data.code,
					nil,
					nil,
					Data.key,
					"A"
				)

		end)

	if not OK then

		return false,
			tostring(Result)

	end

	return true,Result

end

local function GetObjFromBox(
	Box
)

	if not Box then
		return nil
	end

	-- Traverse unlimited (cap 16) — hierarki Build Logic bisa
	-- Blocs > Model > [sub] > Box; limit 4 sebelumnya terlalu sempit
	-- di beberapa tipe block / nesting.
	local Current=Box

	for _=1,16 do

		local Parent=Current.Parent

		if not Parent then
			return nil
		end

		if Parent==Blocs then
			return Current
		end

		Current=Parent

	end

	return nil

end

-- Ambil grid cell resmi block.
-- Prioritas: attribute "p" (server-truth) > pivot Box > Position.
local function ResolveBlockGrid(Box,Block)
	-- 1) Attribute "p" = "X_Y_Z" atau "X_Y_Z,X_Y_Z,..."
	if Block then
		local P=Block:GetAttribute("p")
		if typeof(P)=="string" and P~="" then
			local First=string.split(P,",")[1]
			if First then
				local Parts=string.split(First,"_")
				local X=tonumber(Parts[1])
				local Y=tonumber(Parts[2])
				local Z=tonumber(Parts[3])
				if X and Y and Z then
					return Vector3.new(
						math.floor(X),
						math.floor(Y),
						math.floor(Z)
					),"attr"
				end
			end
		end
	end

	-- 2) Pivot lebih stabil dari Position (PivotOffset)
	local PivotPos
	local OK,PV=pcall(function()
		return Box:GetPivot().Position
	end)
	if OK and PV then
		PivotPos=PV
	else
		PivotPos=Box.Position
	end

	local Grid=PosMonde2Grille(PivotPos)
	return Vector3.new(
		math.floor(Grid.X),
		math.floor(Grid.Y),
		math.floor(Grid.Z)
	),"pivot"
end

-- AutoDetect=false: KUNCI ke START_X/Y/Z (sama persis area build).
-- AutoDetect=true: hanya untuk struktur yang dipindah tool (manual).
function CacheBoxesFromWorkspace(AutoDetect)

	if AutoDetect==nil then
		AutoDetect=false
	end

	local TotalBox=0
	local RejectHierarchy=0
	local RejectRange=0
	local RejectFar=0
	local AttrHits=0
	local PivotHits=0

	-- Index semua box valid: key -> best candidate
	local ByKey={}
	local ZCount={}

	for _,Object in ipairs(Blocs:GetDescendants()) do
		if Object:IsA("BasePart") and Object.Name=="Box" then
			TotalBox+=1

			local Block=GetObjFromBox(Object)
			if not Block then
				RejectHierarchy+=1
			else
				local Grid,Src=ResolveBlockGrid(Object,Block)
				local X,Y,Z=Grid.X,Grid.Y,Grid.Z
				local Expected=GridToWorld(X,Y,Z)

				local PivotPos=Object.Position
				pcall(function()
					PivotPos=Object:GetPivot().Position
				end)

				local Dist=(PivotPos-Expected).Magnitude

				-- Tolak yang jauh dari cell-nya sendiri (noise / bukan grid block)
				if Dist>SCAN_RADIUS*1.25 then
					RejectFar+=1
				else
					if Src=="attr" then
						AttrHits+=1
					else
						PivotHits+=1
					end

					local Key=string.format("%d_%d_%d",X,Y,Z)
					ZCount[Z]=(ZCount[Z] or 0)+1

					local Prev=ByKey[Key]
					if not Prev or Dist<Prev.dist then
						ByKey[Key]={
							x=X,y=Y,z=Z,
							key=Key,
							box=Object,
							block=Block,
							world=Expected,
							dist=Dist,
							src=Src
						}
					end
				end
			end
		end
	end

	local CandidateCount=0
	for _ in pairs(ByKey) do
		CandidateCount+=1
	end

	if DEBUG_LOG then
		Dbg("[SCAN] Total Box:",TotalBox,
			"| hierarchy fail:",RejectHierarchy,
			"| far:",RejectFar,
			"| unique keys:",CandidateCount)
		Dbg("[SCAN] Source attr:",AttrHits,"pivot:",PivotHits)
		Dbg("[SCAN] Locked START=",START_X,START_Y,START_Z,
			"size",X_SIZE,"x",Y_SIZE,"AutoDetect=",AutoDetect)
		local ZParts={}
		for Z,Count in pairs(ZCount) do
			table.insert(ZParts,string.format("Z=%d:%d",Z,Count))
		end
		table.sort(ZParts)
		Dbg("[SCAN] Z dist:",table.concat(ZParts,", "))
	end

	local UseX=START_X
	local UseY=START_Y
	local UseZ=START_Z

	if AutoDetect then
		-- Cari plane yang paling banyak overlap dengan window 51x39
		-- di sekitar START (bukan min global yang geser ke samping)
		local BestScore=-1
		local Best={x=START_X,y=START_Y,z=START_Z}

		-- Kandidat Z: prefer START_Z, lalu Z lain yang ada isinya
		local ZList={START_Z}
		for Z,_ in pairs(ZCount) do
			if Z~=START_Z then
				table.insert(ZList,Z)
			end
		end

		for _,Z in ipairs(ZList) do
			-- Untuk tiap possible origin X/Y di sekitar START ± range
			-- hitung berapa cell yang terisi di window 51x39
			-- Optimasi: kumpulkan semua key di Z ini, cari cluster
			local Points={}
			for Key,C in pairs(ByKey) do
				if C.z==Z then
					table.insert(Points,C)
				end
			end
			if #Points>0 then
				-- Score 1: window TEPAT di START (prioritas utama)
				local ScoreFixed=0
				for _,C in ipairs(Points) do
					local LX=C.x-START_X
					local LY=C.y-START_Y
					if LX>=0 and LX<X_SIZE and LY>=0 and LY<Y_SIZE then
						ScoreFixed+=1
					end
				end
				if ScoreFixed>BestScore then
					BestScore=ScoreFixed
					Best={x=START_X,y=START_Y,z=Z}
				end

				-- Score 2: min-cluster hanya jika fixed jelek & masih dekat START
				if ScoreFixed<(TOTAL_BLOCKS*0.2) then
					local MinX,MinY=math.huge,math.huge
					for _,C in ipairs(Points) do
						if C.x<MinX then MinX=C.x end
						if C.y<MinY then MinY=C.y end
					end
					local ScoreMin=0
					for _,C in ipairs(Points) do
						local LX=C.x-MinX
						local LY=C.y-MinY
						if LX>=0 and LX<X_SIZE and LY>=0 and LY<Y_SIZE then
							ScoreMin+=1
						end
					end
					local DistOrigin=math.abs(MinX-START_X)+math.abs(MinY-START_Y)
					if ScoreMin>BestScore and DistOrigin<=math.max(X_SIZE,Y_SIZE) then
						BestScore=ScoreMin
						Best={x=MinX,y=MinY,z=Z}
					end
				end
			end
		end

		UseX=Best.x
		UseY=Best.y
		UseZ=Best.z
		START_X=UseX
		START_Y=UseY
		START_Z=UseZ
		Dbg("[SCAN] AutoDetect chose",UseX,UseY,UseZ,"score",BestScore)
	end

	-- === FIXED FILL: iterasi cell yang SAMA dengan PrepareBuildData ===
	table.clear(Blocks)
	local Found=0

	for Y=UseY,UseY+Y_SIZE-1 do
		for X=UseX,UseX+X_SIZE-1 do
			local Key=string.format("%d_%d_%d",X,Y,UseZ)
			local C=ByKey[Key]
			if C then
				Found+=1
				Blocks[Key]={
					x=X,
					y=Y,
					z=UseZ,
					key=Key,
					code=Position2CodePosition(Vector3.new(X,Y,UseZ)),
					world=C.world,
					box=C.box,
					block=C.block
				}
			end
		end
	end

	-- Hitung yang di luar window (debug offside)
	for Key,C in pairs(ByKey) do
		if C.z==UseZ then
			local LX=C.x-UseX
			local LY=C.y-UseY
			if not (LX>=0 and LX<X_SIZE and LY>=0 and LY<Y_SIZE) then
				RejectRange+=1
			end
		end
	end

	Dbg("[SCAN] In-window cached:",Found,"/",TOTAL_BLOCKS,
		"| outside window same Z:",RejectRange)
	Dbg("[SCAN] Origin used:",UseX,UseY,UseZ)

	return Found

end

local function WaitForBuiltBoxes(
	Token
)

	local Found=0

	for _=1,
		BUILD_RESCAN_ATTEMPTS
	do

		if IsCancelled(Token) then
			return false,Found
		end

		-- Fixed origin: jangan AutoDetect saat sync build
		Found=
			CacheBoxesFromWorkspace(false)

		Status.Text=
			string.format(
				"SYNC BLOCKS %d/%d",
				Found,
				TOTAL_BLOCKS
			)

		if
			Found>=TOTAL_BLOCKS
		then

			return true,Found

		end

		task.wait(
			BUILD_RESCAN_DELAY
		)

	end

	return Found>0,Found

end

local function PrepareBuildData()

	local Data=
		table.create(
			TOTAL_BLOCKS
		)

	local Index=0

	for Y=START_Y,
		START_Y+Y_SIZE-1
	do

		for X=START_X,
			START_X+X_SIZE-1
		do

			Index+=1

			local Grid=
				Vector3.new(
					X,
					Y,
					START_Z
				)

			Data[Index]=
				{
					x=X,
					y=Y,
					z=START_Z,

					key=
						string.format(
							"%d_%d_%d",
							X,
							Y,
							START_Z
						),

					code=
						Position2CodePosition(
							Grid
						),

					world=
						GridToWorld(
							X,
							Y,
							START_Z
						)
				}

		end

	end

	return Data

end

function BuildGrid()

	if
		Building
		or
		Playing
		or
		Scanning
		or
		Deleting
		or
		SettingPos
	then

		Status.Text="BUSY"
		return

	end

	Building=true

	local Token=
		NewRunToken()

	table.clear(
		Blocks
	)

	Status.Text=
		"PREPARING BUILD..."

	local BuildData=
		PrepareBuildData()

	local NextIndex=0
	local Completed=0
	local Failed=0
	local WorkersDone=0

	local function Worker()

		while true do

			if IsCancelled(Token) then
				break
			end

			local Index=
				NextIndex+1

			NextIndex=Index

			if
				Index>TOTAL_BLOCKS
			then

				break

			end

			local Success=
				PlaceBlock(
					BuildData[Index]
				)

			if
				IsCancelled(Token)
			then

				break

			end

			if Success then
				Completed+=1
			else
				Failed+=1
			end

			if
				Completed%BUILD_BATCH==0
			then

				Status.Text=
					string.format(
						"BUILD %d/%d",
						Completed,
						TOTAL_BLOCKS
					)

				task.wait()

			end

		end

		WorkersDone+=1

	end

	for _=1,
		BUILD_WORKERS
	do

		task.spawn(
			Worker
		)

	end

	while
		WorkersDone<BUILD_WORKERS
	do

		if IsCancelled(Token) then

			Building=false
			Status.Text="STOPPED"

			return

		end

		Status.Text=
			string.format(
				"BUILD %d/%d",
				Completed,
				TOTAL_BLOCKS
			)

		task.wait()

	end

	if IsCancelled(Token) then

		Building=false
		Status.Text="STOPPED"

		return

	end

	Status.Text=
		string.format(
			"PLACED %d/%d",
			Completed,
			TOTAL_BLOCKS
		)

	-- Tunggu replicate client sebelum sync scan
	task.wait(0.75)

	local Synced,Found=
		WaitForBuiltBoxes(
			Token
		)

	Building=false

	if not Synced then

		Status.Text=
			string.format(
				"BUILD DONE • %d BOX",
				Found
			)

		return

	end

	Status.Text=
		string.format(
			"READY • %d/%d BLOCKS",
			Found,
			TOTAL_BLOCKS
		)

	Dbg("BUILD:",Completed,"/",TOTAL_BLOCKS,"FAILED:",Failed,"CACHED:",Found)

end
end

local DeleteAllBlocks
do
local function DeleteOneBlock(Data)

	if
		not Data
		or
		not Data.block
	then

		return false,
			"BLOCK NIL"

	end

	local Block=
		Data.block

	if
		not Block.Parent
	then

		return true,
			"ALREADY REMOVED"

	end

	local OriginalParent=
		Block.Parent

	local P=
		Block:GetAttribute(
			"p"
		)

	Block:SetAttribute(
		"t",
		os.clock()
	)

	Block.Parent=
		FauxBlocsDetruits

	local V1=nil
	local V2=nil
	local V3=nil
	local V4=nil

	local OK,Err=
		pcall(function()

			V1,V2,V3,V4=
				DeleteBloc:InvokeServer(
					nil,
					nil,
					nil,
					Block
				)

		end)

	if not OK then

		if
			Block.Parent==
				FauxBlocsDetruits
		then

			Block.Parent=
				OriginalParent

			Block:SetAttribute(
				"t",
				nil
			)

		end

		return false,
			tostring(Err)

	end

	if
		V1==-1
	then

		return false,
			"SERVER -1"

	end

	if
		V1==true
	then

		return true,
			P

	end

	if
		V4
		and
		typeof(V4)=="Instance"
	then

		pcall(function()

			V4.Parent=
				Blocs

			V4:SetAttribute(
				"t",
				nil
			)

		end)

	elseif
		Block
		and
		Block.Parent==
			FauxBlocsDetruits
	then

		Block.Parent=
			OriginalParent

		Block:SetAttribute(
			"t",
			nil
		)

	end

	return false,
		tostring(
			V2
			or
			V3
			or
			"DELETE FAILED"
		)

end

function DeleteAllBlocks()

	if
		Deleting
		or
		Building
		or
		Playing
		or
		Scanning
		or
		SettingPos
	then

		return

	end

	Deleting=true

	local Token=
		NewRunToken()

	-- Seperti paint: pakai cache Instance yang sudah diingat.
	-- Jangan clear + re-scan dulu, biar tetap bisa delete setelah dipindah tool.
	local Found = 0
	for _ in pairs(Blocks) do
		Found += 1
	end

	if Found <= 0 then
		Status.Text = "SCANNING BLOCKS..."
		Found = CacheBoxesFromWorkspace(false)
		if Found == 0 then
			Found = CacheBoxesFromWorkspace(true)
		end
	else
		Status.Text = string.format("USING CACHED %d BLOCKS", Found)
	end

	if IsCancelled(Token) then
		Deleting = false
		Status.Text = "STOPPED"
		return
	end

	if Found <= 0 then
		Deleting = false
		Status.Text = "NO BLOCK FOUND"
		return
	end

	local List = table.create(Found)
	local Count = 0

	for _, Data in pairs(Blocks) do
		-- Instance masih hidup & masih di folder Blocs (meski posisinya sudah dipindah)
		if Data and Data.block and Data.block.Parent == Blocs then
			Count += 1
			List[Count] = Data
		end
	end

	if
		Count==0
	then

		Deleting=false
		Status.Text=
			"NO VALID BLOCK FOUND"

		return

	end

	local Completed=0
	local Failed=0
	local BatchStart=1

	while
		BatchStart<=Count
	do

		if
			IsCancelled(Token)
		then

			Deleting=false
			Status.Text="STOPPED"

			return

		end

		local BatchEnd=
			math.min(
				BatchStart+
				DELETE_BATCH-
				1,
				Count
			)

		local BatchCount=
			BatchEnd-
			BatchStart+
			1

		local BatchNext=0
		local WorkersDone=0

		local WorkerCount=
			math.min(
				DELETE_WORKERS,
				BatchCount
			)

		local function Worker()

			while true do

				if
					IsCancelled(Token)
				then

					break

				end

				local LocalIndex=
					BatchNext+1

				BatchNext=
					LocalIndex

				if
					LocalIndex>BatchCount
				then

					break

				end

				local GlobalIndex=
					BatchStart+
					LocalIndex-
					1

				local Data=
					List[GlobalIndex]

				local Success,Error=
					DeleteOneBlock(
						Data
					)

				if
					IsCancelled(Token)
				then

					break

				end

				if Success then

					Completed+=1

					Blocks[
						Data.key
					]=nil

				else

					Failed+=1

					warn(
						"[DELETE]",
						Data.key,
						Error
					)

				end

			end

			WorkersDone+=1

		end

		for _=1,
			WorkerCount
		do

			task.spawn(
				Worker
			)

		end

		while
			WorkersDone<WorkerCount
		do

			if
				IsCancelled(Token)
			then

				Deleting=false
				Status.Text="STOPPED"

				return

			end

			Status.Text=
				string.format(
					"DELETE %d/%d • FAIL %d",
					Completed,
					Count,
					Failed
				)

			task.wait()

		end

		BatchStart=
			BatchEnd+
			1

	end

	table.clear(
		Blocks
	)

	table.clear(
		PreviousPixels
	)

	Deleting=false

	Status.Text=
		string.format(
			"DELETED %d/%d • FAILED %d",
			Completed,
			Count,
			Failed
		)

	Dbg("DELETE:",Completed,"/",Count,"FAILED:",Failed)

end
end

local function ScanBlocks()

	if
		Scanning
		or
		Building
		or
		Playing
		or
		Deleting
		or
		SettingPos
	then

		return

	end

	Scanning=true

	local Token=
		NewRunToken()

	table.clear(
		Blocks
	)

	Status.Text=
		"SCANNING BLOCKS..."

	-- SELALU fixed dulu = area yang SAMA dengan BUILD / SET POS
	-- Jangan AutoDetect otomatis (itu yang bikin scan loncat ke samping)
	local Found=
		CacheBoxesFromWorkspace(false)

	-- AutoDetect HANYA jika benar-benar 0 (mis. setelah pindah tool total)
	if Found==0 then
		Dbg("[SCAN] Fixed empty — last resort AutoDetect")
		Status.Text="SCAN AUTO-DETECT..."
		Found=CacheBoxesFromWorkspace(true)
	elseif Found<(TOTAL_BLOCKS*0.5) then
		Dbg("[SCAN] Partial",Found,"/",TOTAL_BLOCKS,
			"— keep FIXED origin")
	end

	Scanning=false

	if
		IsCancelled(Token)
	then

		Status.Text=
			"SCAN STOPPED"

		return

	end

	Status.Text=
		string.format(
			"SCANNED • %d/%d BLOCKS",
			Found,
			TOTAL_BLOCKS
		)

	Dbg("SCAN:",Found,"/",TOTAL_BLOCKS)

end

local ClearMediaCaches,LoadStartup,LoadBadApple,LoadCustomBA,LoadRGB
do
local function LoadText(URL)

local OK,Text=pcall(function()
		return game:HttpGet(URL,true)
	end)

	if not OK or type(Text)~="string" or Text=="" then
		-- fallback: fungsi request bawaan executor
		local Req=nil
		pcall(function()
			Req=(syn and syn.request) or http_request or request or (http and http.request)
		end)
		if Req then
			local OK2,Res=pcall(Req,{Url=URL,Method="GET"})
			if OK2 and type(Res)=="table" and type(Res.Body)=="string" then
				OK=true
				Text=Res.Body
			end
		end
	end









	if
		not OK
		or
		type(Text)~="string"
		or
		Text==""
	then

		return nil

	end

	Text=
		Text:gsub(
			"\239\187\191",
			""
		)

	Text=Text:gsub("\r","")

	-- GitHub / CDN 404 HTML — jangan dianggap frame data
	local Head=Text:sub(1,256):lower()
	if Head:find("<!doctype",1,true)
		or Head:find("<html",1,true)
		or Head:find("404: not found",1,true)
		or Head:find("400: invalid",1,true)
		or Head:find("429:",1,true)
	then
		return nil
	end

	return Text

end

-- Header sebelum payload:
-- FPS=10
-- MODE=BA
-- WIDTH=51
-- HEIGHT=39
-- ---
-- <payload>
local function ApplyMediaHeader(Text)

	MediaSrcW=nil
	MediaSrcH=nil

	if not Text or Text=="" then
		return Text
	end

	LastParsedFps=nil
	MediaSrcW=nil
	MediaSrcH=nil

	-- FRAME_DELAY = kecepatan ASLI konten (header, atau default 20 FPS tanpa header).
	-- Pilihan FPS user TIDAK mengubah ini; cuma ngatur seberapa sering render (skip frame).
	FRAME_DELAY=1/DEFAULT_FPS
	LastParsedFps=DEFAULT_FPS

	local Header=nil
	local Body=Text

	local SepStart,SepEnd=Text:find("%-%-%-")
	if SepStart then
		Header=Text:sub(1,SepStart-1)
		Body=Text:sub((SepEnd or SepStart)+1)
		Body=Body:gsub("^[\n]+","")
	else
		local FirstLine=Text:match("^[^\n]+")
		if FirstLine and FirstLine:match("^%s*FPS%s*=") then
			Header=Text:match("^(.-)\n") or Text
			Body=Text:gsub("^[^\n]*\n?","",1)
		end
	end

	if Header then
		local FpsStr=Header:match("FPS%s*=%s*([%d%.]+)")
		local Fps=tonumber(FpsStr)
		if Fps and Fps>0 and Fps<=120 then
			LastParsedFps=Fps
			FRAME_DELAY=1/Fps
			Dbg("MEDIA FPS=",Fps,"FRAME_DELAY=",FRAME_DELAY)
		end

		local Ww=tonumber(Header:match("WIDTH%s*=%s*(%d+)"))
		local Hh=tonumber(Header:match("HEIGHT%s*=%s*(%d+)"))
		if Ww and Hh and Ww>0 and Hh>0 and Ww<=512 and Hh<=512 then
			MediaSrcW=Ww
			MediaSrcH=Hh
		end
	end

	-- Tanpa WIDTH/HEIGHT di header → anggap sumber default 51×39
	if not MediaSrcW or not MediaSrcH then
		MediaSrcW=DEFAULT_X_SIZE
		MediaSrcH=DEFAULT_Y_SIZE
	end

	return Body

end

local function ScaleBAString(Src,Sw,Sh,Dw,Dh)
	if not Src or Sw<=0 or Sh<=0 or Dw<=0 or Dh<=0 then
		return nil
	end
	if Sw==Dw and Sh==Dh and #Src==Dw*Dh then
		return Src
	end
	local Out=table.create(Dw*Dh)
	local Idx=0
	for Y=0,Dh-1 do
		local Sy=math.clamp(math.floor(Y*Sh/Dh),0,Sh-1)
		for X=0,Dw-1 do
			local Sx=math.clamp(math.floor(X*Sw/Dw),0,Sw-1)
			local Si=Sy*Sw+Sx+1
			Idx+=1
			local Ch=Src:sub(Si,Si)
			Out[Idx]=(Ch=="A" or Ch=="B") and Ch or "B"
		end
	end
	return table.concat(Out)
end

local function ScaleRGBList(Pixels,Sw,Sh,Dw,Dh)
	if not Pixels or Sw<=0 or Sh<=0 or Dw<=0 or Dh<=0 then
		return nil
	end
	if Sw==Dw and Sh==Dh then
		return Pixels
	end
	local Out=table.create(Dw*Dh)
	local Idx=0
	local Black=Color3.new(0,0,0)
	for Y=0,Dh-1 do
		local Sy=math.clamp(math.floor(Y*Sh/Dh),0,Sh-1)
		for X=0,Dw-1 do
			local Sx=math.clamp(math.floor(X*Sw/Dw),0,Sw-1)
			local Si=Sy*Sw+Sx+1
			Idx+=1
			Out[Idx]=Pixels[Si] or Black
		end
	end
	return Out
end

local COMMON_DIMS={
	{51,39},{32,24},{40,30},{48,36},{64,36},{64,48},{80,45},{96,54},{16,16},{24,24},{32,32},
}

local function InferSrcDims(Count)
	if not Count or Count<=0 then
		return nil,nil
	end
	-- prioritas: header media
	if MediaSrcW and MediaSrcH and MediaSrcW*MediaSrcH==Count then
		return MediaSrcW,MediaSrcH
	end
	-- default klasik Bad Apple 51×39
	if Count==DEFAULT_X_SIZE*DEFAULT_Y_SIZE then
		return DEFAULT_X_SIZE,DEFAULT_Y_SIZE
	end
	if Count==TOTAL_BLOCKS then
		return X_SIZE,Y_SIZE
	end
	for _,D in ipairs(COMMON_DIMS) do
		if D[1]*D[2]==Count then
			return D[1],D[2]
		end
	end
	for W=8,math.min(256,Count) do
		if Count%W==0 then
			local H=Count/W
			if H>=8 and H<=256 then
				local Aspect=W/H
				if Aspect>=0.75 and Aspect<=2.8 then
					return W,H
				end
			end
		end
	end
	return nil,nil
end

local function NormalizeBAFrame(FrameStr)
	if type(FrameStr)~="string" or #FrameStr==0 then
		return nil
	end
	-- buang karakter non A/B
	if FrameStr:find("[^ABab]") then
		FrameStr=FrameStr:gsub("[^ABab]",""):upper()
	else
		FrameStr=FrameStr:upper()
	end
	if #FrameStr==0 then
		return nil
	end
	if #FrameStr==TOTAL_BLOCKS then
		return FrameStr
	end
	local Sw,Sh=InferSrcDims(#FrameStr)
	if Sw and Sh then
		return ScaleBAString(FrameStr,Sw,Sh,X_SIZE,Y_SIZE)
	end
	return nil
end

local function ParseRGBFrame(Text)

	local Pixels={}
	local Count=0

	for R,G,B in
		Text:gmatch(
			"(%d+)%s*,%s*(%d+)%s*,%s*(%d+)"
		)
	do

		R=tonumber(R)
		G=tonumber(G)
		B=tonumber(B)

		if
			R and G and B
			and R>=0 and R<=255
			and G>=0 and G<=255
			and B>=0 and B<=255
		then
			Count+=1
			Pixels[Count]=Color3.fromRGB(R,G,B)
		end

	end

	if Count==0 then
		return nil
	end

	if Count==TOTAL_BLOCKS then
		return Pixels
	end

	local Sw,Sh=InferSrcDims(Count)
	if Sw and Sh then
		return ScaleRGBList(Pixels,Sw,Sh,X_SIZE,Y_SIZE)
	end

	return nil

end

local function LoadRGBFrames(
	URL,
