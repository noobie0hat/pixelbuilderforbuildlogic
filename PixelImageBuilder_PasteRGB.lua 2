do
	local function KillOld(Host)
		if Host then
			local Old=Host:FindFirstChild("PixelImageBuilder")
			if Old then
				pcall(function()
					Old:Destroy()
				end)
			end
		end
	end
	KillOld(PlayerGui)
	pcall(function()
		KillOld(game:GetService("CoreGui"))
	end)
	pcall(function()
		if gethui then
			KillOld(gethui())
		end
	end)
end








