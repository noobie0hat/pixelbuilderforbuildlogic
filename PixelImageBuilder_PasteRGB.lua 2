do
local BLACK=
	Color3.new(
		0,
		0,
		0
	)

local WHITE=
	Color3.new(
		1,
		1,
		1
	)

local function ApplyBrightness(
	Color
)

	local R=
		math.floor(
			Color.R*255+
			0.5
		)

	local G=
		math.floor(
			Color.G*255+
			0.5
		)

	local B=
		math.floor(
			Color.B*255+
			0.5
		)

	R=
		math.min(
			255,
			R+
			CUSTOM_BRIGHTNESS
		)

	G=
		math.min(
			255,
			G+
			CUSTOM_BRIGHTNESS
		)

	B=
		math.min(
			255,
			B+
			CUSTOM_BRIGHTNESS
		)

	R=
		math.max(
			0,
			R
		)

	G=
		math.max(
			0,
			G
		)

	B=
		math.max(
			0,
			B
		)

	return
		Color3.fromRGB(
			R,
			G,
			B
		)

end

local function PaintBox(
	Box,
	Color
)

	if not Box or not Box.Parent then
		return false
	end

	local OK=pcall(function()
		Colorie:FireServer(
			Color,
			"Default",
			Box,
			0,
			2
		)
	end)

	return OK

end

local function GetCharacter(
	Frame,
	X,
	Y
)

	if type(Frame)~="string" or X<0 or Y<0 or X>=X_SIZE or Y>=Y_SIZE then
		return nil
	end

	local FrameY=
		Y_SIZE-
		1-
		Y

	local Index=
		FrameY*
		X_SIZE+
		X+
		1

	if Index<1 or Index>#Frame then
		return nil
	end

	local Byte=
		string.byte(
			Frame,
			Index
		)

	if
		Byte==65
	then

		return "A"

	end

	if
		Byte==66
	then

		return "B"

	end

	return nil

end

local function GetRGBColor(
	Frame,
	X,
	Y
)

	if not Frame or X<0 or Y<0 or X>=X_SIZE or Y>=Y_SIZE then
		return nil
	end

	local FrameY=
		Y_SIZE-
		1-
		Y

	local Index=
		FrameY*
		X_SIZE+
		X+
		1

	return Frame[Index]

end

local function PrepareABFrame(
	Frame,
	FirstFrame
)

	local Workers=
		table.create(
			PAINT_WORKERS
		)

	local Counts=
		table.create(
			PAINT_WORKERS,
			0
		)

	for Worker=1,
		PAINT_WORKERS
	do

		Workers[Worker]={}

	end

	local Position=0

	for Y=0,
		Y_SIZE-1
	do

		for X=0,
			X_SIZE-1
		do

			Position+=1

			local Worker=
				(
					Position-
					1
				)%
				PAINT_WORKERS+
				1

			local Character=
				GetCharacter(
					Frame,
					X,
					Y
				)

			if
				Character=="A"
				or
				Character=="B"
			then

				local Key=
					string.format(
						"%d_%d_%d",
						X+
						START_X,
						Y+
						START_Y,
						START_Z
					)

				local Data=
					Blocks[Key]

				if Data then

					local Old=
						PreviousPixels[Key]

					if
						FirstFrame
						or
						Old~=Character
					then

						local Count=
							Counts[Worker]+1

						Counts[Worker]=
							Count

						Workers[Worker][Count]=
							{
								Box=Data.box,

								Color=
									Character=="A"
									and
									WHITE
									or
									BLACK,

								Key=Key,
								Value=Character
							}

					end

				end

			end

		end

	end

	return
		Workers,
		Counts

end

local function PrepareRGBFrame(
	Frame,
	FirstFrame,
	UseBrightness
)

	local Workers=
		table.create(
			PAINT_WORKERS
		)

	local Counts=
		table.create(
			PAINT_WORKERS,
			0
		)

	for Worker=1,
		PAINT_WORKERS
	do

		Workers[Worker]={}

	end

	local Position=0

	for Y=0,
		Y_SIZE-1
	do

		for X=0,
			X_SIZE-1
		do

			Position+=1

			local Worker=
				(
					Position-
					1
				)%
				PAINT_WORKERS+
				1

			local Key=
				string.format(
					"%d_%d_%d",
					X+
					START_X,
					Y+
					START_Y,
					START_Z
				)

			local Data=
				Blocks[Key]

			local Color=
				GetRGBColor(
					Frame,
					X,
					Y
				)

			if
				Data
				and
				Color
			then

				if
					UseBrightness
					and
					CUSTOM_BRIGHTNESS~=0
				then

					Color=
						ApplyBrightness(
							Color
						)

				end

				local Old=
					PreviousPixels[Key]

				local Changed=
					FirstFrame

				if
					not Changed
					and
					Old
				then

					if
						type(Old)=="table"
					then

						local R=
							math.floor(
								Color.R*
								255+
								0.5
							)

						local G=
							math.floor(
								Color.G*
								255+
								0.5
							)

						local B=
							math.floor(
								Color.B*
								255+
								0.5
							)

						Changed=
							math.floor(Old.R*255+0.5)~=R
							or
							math.floor(Old.G*255+0.5)~=G
							or
							math.floor(Old.B*255+0.5)~=B

					else

						Changed=true

					end

				end

				if Changed then

					local Count=
						Counts[Worker]+1

					Counts[Worker]=
						Count

					Workers[Worker][Count]=
						{
							Box=Data.box,
							Color=Color,
							Key=Key,

							Value=
								{
									R=Color.R,
									G=Color.G,
									B=Color.B
								}
						}

				end

			end

		end

	end

	return
		Workers,
		Counts

end

local function CommitFrame(
	Workers,
	Counts
)

	for Worker=1,
		PAINT_WORKERS
	do

		local Items=
			Workers[Worker]

		local Count=
			Counts[Worker]

		for Index=1,
			Count
		do

			local Item=
				Items[Index]

			PreviousPixels[
				Item.Key
			]=
				Item.Value

		end

	end

end

local function PaintPreparedFrame(
	Workers,
	Counts,
	Token
)

	local ActiveWorkers=0
	local FinishedWorkers=0

	for Worker=1,
		PAINT_WORKERS
	do

		local Count=
			Counts[Worker]

		if Count>0 then

			ActiveWorkers+=1

			task.spawn(function()

				local Items=
					Workers[Worker]

				local Index=1

				while
					Index<=Count
				do

					if
						IsCancelled(Token)
					then

						break

					end

					local EndIndex=
						math.min(
							Index+
							PAINT_BATCH-
							1,
							Count
						)

					for ItemIndex=Index,
						EndIndex
					do

						if
							IsCancelled(Token)
						then

							break

						end

						local Item=
							Items[
								ItemIndex
							]

						PaintBox(
							Item.Box,
							Item.Color
						)

					end

					Index=
						EndIndex+
						1

					if
						Index<=Count
						and
						not IsCancelled(Token)
					then

						task.wait()

					end

				end

				FinishedWorkers+=1

			end)

		end

	end

	if
		ActiveWorkers==0
	then

		return
			not IsCancelled(Token)

	end

	while
		FinishedWorkers<
		ActiveWorkers
	do

		if
			IsCancelled(Token)
		then

			return false

		end

		task.wait()

	end

	return
		not IsCancelled(Token)

end

function PaintFrame(
	Frame,
	FirstFrame,
	Token,
	RGBMode,
	UseBrightness
)

	if not Frame then
		return false
	end
	if RGBMode then
		if type(Frame)~="table" then
			return false
		end
	else
		if type(Frame)~="string" or #Frame==0 then
			return false
		end
	end

	local Workers
	local Counts

	if RGBMode then

		Workers,Counts=
			PrepareRGBFrame(
				Frame,
				FirstFrame,
				UseBrightness
			)

	else

		Workers,Counts=
			PrepareABFrame(
				Frame,
				FirstFrame
			)

	end

	local TotalChanges=0

	for Worker=1,
		PAINT_WORKERS
	do

		TotalChanges+=
			Counts[Worker]

	end

	if
		TotalChanges==0
	then

		return true

	end

	local OK=
		PaintPreparedFrame(
			Workers,
			Counts,
			Token
		)

	if
		not OK
		or
		IsCancelled(Token)
	then

		return false

	end

	CommitFrame(
		Workers,
		Counts
	)

	return true

end

