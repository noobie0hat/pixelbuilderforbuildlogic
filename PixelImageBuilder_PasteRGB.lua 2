	local Frames={
		MakeTextRGBFrame("404",Color3.fromRGB(255,70,70)),
		MakeTextRGBFrame(Line2,Color3.fromRGB(255,120,80)),
		MakeTextRGBFrame("3",Color3.fromRGB(255,220,80)),
		MakeTextRGBFrame("2",Color3.fromRGB(255,220,80)),
		MakeTextRGBFrame("1",Color3.fromRGB(120,255,120)),
	}
	local Durations={1.15,1.15,1.0,1.0,1.0}
	local Labels={"404 STARTUP NOT FOUND!","404 STARTUP NOT FOUND!","COUNTDOWN 3","COUNTDOWN 2","COUNTDOWN 1"}
	local First=true
	for i,Frame in ipairs(Frames) do
		if IsCancelled(Token) then
			return false
		end
		Status.Text=Labels[i] or "404 STARTUP"
		local t0=os.clock()
		local OK=PaintFrame(Frame,First,Token,true,false)
		if not OK then
			return false
		end
		First=false
		local WaitLeft=Durations[i]-(os.clock()-t0)
		if WaitLeft>0 then
			task.wait(WaitLeft)
		end
	end
	return true
end

function PlayStartup(
	Token
)

	if type(StartupFrames)~="table" or #StartupFrames==0 then
		return false
	end

	-- kecepatan asli startup (tidak diubah pilihan FPS)
	local SrcDelay=StartupFrameDelay or FRAME_DELAY
	if not SrcDelay or SrcDelay<=0 then
		SrcDelay=DEFAULT_FRAME_DELAY
	end

	-- pilihan FPS cuma ngatur frekuensi render (skip frame), maksimal = FPS asli
	local RenderDelay=SrcDelay
	if UserFpsOverride and UserFpsOverride>0 then
		RenderDelay=math.max(SrcDelay,1/UserFpsOverride)
	end

	local Total=#StartupFrames
	local StartTime=os.clock()
	local NextAt=StartTime
	local LastIndex=0
	local FirstFrame=true

	while true do

		if IsCancelled(Token) then
			return false
		end

		local Elapsed=os.clock()-StartTime

		if Elapsed>=STARTUP_DURATION then
			return true
		end

		-- frame dipilih berdasarkan WAKTU (looping), jadi durasi tetap walau FPS kecil
		local FrameIndex=math.floor(Elapsed/SrcDelay)%Total+1

		if FrameIndex~=LastIndex then

			local OK=PaintFrame(
				StartupFrames[FrameIndex],
				FirstFrame,
				Token,
				true,
				false
			)

			FirstFrame=false

			if not OK then
				return false
			end

			LastIndex=FrameIndex

		end

		Status.Text=string.format(
			"STARTUP RGB %.1f/%.1f",
			math.min(Elapsed,STARTUP_DURATION),
			STARTUP_DURATION
		)

		NextAt=NextAt+RenderDelay
		local Now=os.clock()

		if NextAt<Now then
			NextAt=Now
		end

		if NextAt>Now then
			task.wait(NextAt-Now)
		else
			task.wait()
		end

	end

end
end

local function PlayMode(
	Mode
)

	if
		Playing
		or
		Building
		or
		Scanning
		or
		Deleting
		or
		SettingPos
	then

		return

	end

	if
		next(Blocks)==nil
	then

		Status.Text=
			"BUILD OR SCAN FIRST"

		return

	end

	if
		not COLOR_ENABLED
	then

		Status.Text=
			"COLOR OFF - tekan tombol COLOR dulu"

		return

	end

	Playing=true

	local Token=
		NewRunToken()

	ResetPixelState()

	if Mode==true then

		PlayRGBButton.Text=
			"PREPARING RGB..."

	elseif Mode=="customba" then

		PlayCustomBAButton.Text=
			"PREPARING..."

	else

		PlayBadAppleButton.Text=
			"PREPARING..."

	end

	if
		not PreparePlayback(
			Mode
		)
	then

		Playing=false

		PlayBadAppleButton.Text=
			"PLAY BAD APPLE"

		PlayRGBButton.Text=
			"RENDER RGB IMAGE"

		PlayCustomBAButton.Text=
			"PLAY CUSTOM BA"

		return

	end

	if
		IsCancelled(Token)
	then

		Playing=false
		Status.Text="STOPPED"

		return

	end

	if Mode==true then

		PlayRGBButton.Text=
			"STARTUP..."

	elseif Mode=="customba" then

		PlayCustomBAButton.Text=
			"STARTUP..."

	else

		PlayBadAppleButton.Text=
			"STARTUP..."

	end

	local StartupOK=true
	if StartupMissing or type(StartupFrames)~="table" or #StartupFrames==0 then
		StartupOK=PlayMissingStartupSequence(Token)
	else
		StartupOK=PlayStartup(Token)
	end

	if not StartupOK then

		Playing=false

		PlayBadAppleButton.Text=
			"PLAY BAD APPLE"

		PlayRGBButton.Text=
			"RENDER RGB IMAGE"

		PlayCustomBAButton.Text=
			"PLAY CUSTOM BA"

		Status.Text="STOPPED"

		return

	end

	if
		IsCancelled(Token)
	then

		Playing=false
		Status.Text="STOPPED"

		return

	end

	local Frames
	local Label
	local RGBMode

	if Mode==true then

		Frames=RGBFrames
		Label="RGB"
		RGBMode=true

	elseif Mode=="customba" then

		Frames=CustomBAFrames
		Label="CUSTOM BA"
		RGBMode=false

	else

		Frames=BadAppleFrames
		Label="BAD APPLE"
		RGBMode=false

	end

	-- pakai FPS konten utama (bukan startup)
	FRAME_DELAY=MainFrameDelay or FRAME_DELAY
	if not FRAME_DELAY or FRAME_DELAY<=0 then
		FRAME_DELAY=DEFAULT_FRAME_DELAY
	end

	local FirstMainFrame=true

	if type(Frames)~="table" or #Frames==0 then
		Playing=false
		Status.Text="NO FRAMES"
		PlayBadAppleButton.Text="PLAY BAD APPLE"
		PlayRGBButton.Text="RENDER RGB IMAGE"
		PlayCustomBAButton.Text="PLAY CUSTOM BA"
		return
	end

	-- Timeline ngikut kecepatan ASLI konten (FRAME_DELAY = 1/fps header, atau 20 default).
	-- FPS pilihan user cuma ngatur seberapa sering render: frame yang kelewat di-SKIP,
	-- jadi durasi video tetap sama (bukan slow motion).
	local SrcDelay=FRAME_DELAY
	local RenderDelay=SrcDelay

	if UserFpsOverride and UserFpsOverride>0 then
		RenderDelay=math.max(SrcDelay,1/UserFpsOverride)
	end

	local TotalFrames=#Frames
	local PlayStart=os.clock()
	local NextAt=PlayStart
	local LastIndex=0

	while true do

		if IsCancelled(Token) then
			break
		end

		local FrameNumber=math.floor((os.clock()-PlayStart)/SrcDelay)+1

		if FrameNumber>TotalFrames then
			break
		end

		if FrameNumber~=LastIndex then

			local OK=PaintFrame(
				Frames[FrameNumber],
				FirstMainFrame,
				Token,
				RGBMode,
				RGBMode
			)

			FirstMainFrame=false

			if not OK then
				break
			end

			LastIndex=FrameNumber

			Status.Text=string.format(
				"%s %d/%d",
				Label,
				FrameNumber,
				TotalFrames
			)

		end

		NextAt=NextAt+RenderDelay
		local Now=os.clock()

		if NextAt<Now then
			NextAt=Now
		end

		if NextAt>Now then
			task.wait(NextAt-Now)
		else
			task.wait()
		end

	end

	Playing=false

	Status.Text=
		IsCancelled(Token)
		and
		"STOPPED"
		or
		"PLAYBACK FINISHED"

	PlayBadAppleButton.Text=
		"PLAY BAD APPLE"

	PlayRGBButton.Text=
		"RENDER RGB IMAGE"

	PlayCustomBAButton.Text=
		"PLAY CUSTOM BA"

	StopRequested=false

end

