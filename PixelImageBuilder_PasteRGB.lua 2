local function IsPointOverUI(X,Y)
	local Host=Gui.Parent

	if Host and Host:IsA("BasePlayerGui") then
		local OK,List=pcall(function()
			return Host:GetGuiObjectsAtPosition(X,Y)
		end)
		if OK and List then
			for _,G in ipairs(List) do
				if G:IsDescendantOf(Gui) then
					return true
				end
			end
			return false
		end
	end

	for _,Obj in ipairs(Gui:GetChildren()) do
		if Obj:IsA("GuiObject") and Obj.Visible then
			local P=Obj.AbsolutePosition
			local S=Obj.AbsoluteSize
			if X>=P.X and X<=P.X+S.X and Y>=P.Y and Y<=P.Y+S.Y then
				return true
			end
		end
	end

	return false
end

