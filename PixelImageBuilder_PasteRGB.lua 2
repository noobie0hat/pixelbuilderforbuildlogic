local function DepsReady()
	if PlacerBloc and DeleteBloc and Colorie and BitBuffer and Blocs and PosOriginPart then
		return true
	end
	Status.Text="DEPENDENCY BELUM SIAP"
	return false
end

task.spawn(function()
	Status.Text="LOADING DEPENDENCY..."

	local Events=ReplicatedStorage:WaitForChild("Events",30)
	if Events then
		PlacerBloc=Events:WaitForChild("PlacerBloc",30)
		DeleteBloc=Events:WaitForChild("DeleteBloc",30)
		Colorie=Events:WaitForChild("RemoteEventColorie",30)
	end

	local Modules=ReplicatedStorage:WaitForChild("Modules",30)
	local BitBufferModule=Modules and Modules:WaitForChild("BitBuffer",30)
	if BitBufferModule then
		local OK,Result=pcall(require,BitBufferModule)
		if OK then
			BitBuffer=Result
		else
			warn("[PixelBuilder] require BitBuffer gagal:",Result)
		end
	end

	Blocs=workspace:WaitForChild("Blocs",30)
	PosOriginPart=workspace:WaitForChild("PosOrigin",30)

	local Missing={}
	if not Events then table.insert(Missing,"ReplicatedStorage.Events") end
	if not PlacerBloc then table.insert(Missing,"PlacerBloc") end
	if not DeleteBloc then table.insert(Missing,"DeleteBloc") end
	if not Colorie then table.insert(Missing,"RemoteEventColorie") end
	if not BitBuffer then table.insert(Missing,"Modules.BitBuffer") end
	if not Blocs then table.insert(Missing,"workspace.Blocs") end
	if not PosOriginPart then table.insert(Missing,"workspace.PosOrigin") end

	if #Missing>0 then
		warn("[PixelBuilder] Dependency tidak ketemu: "..table.concat(Missing,", "))
		Status.Text="MISSING: "..table.concat(Missing,", ")
	else
		Status.Text="READY"
		print("[PixelBuilder] semua dependency OK")
	end
end)

