local PlayMissingStartupSequence,PlayStartup
do
-- Bitmap 3x5 digit/huruf sederhana untuk overlay di grid
local BITMAP_GLYPHS={
	["0"]={"111","101","101","101","111"},
	["1"]={"010","110","010","010","111"},
	["2"]={"111","001","111","100","111"},
	["3"]={"111","001","111","001","111"},
	["4"]={"101","101","111","001","001"},
	["5"]={"111","100","111","001","111"},
	["6"]={"111","100","111","101","111"},
	["7"]={"111","001","010","010","010"},
	["8"]={"111","101","111","101","111"},
	["9"]={"111","101","111","001","111"},
	["A"]={"010","101","111","101","101"},
	["B"]={"110","101","110","101","110"},
	["D"]={"110","101","101","101","110"},
	["E"]={"111","100","110","100","111"},
	["F"]={"111","100","110","100","100"},
	["N"]={"101","111","111","101","101"},
	["O"]={"111","101","101","101","111"},
	["R"]={"110","101","110","101","101"},
	["S"]={"111","100","111","001","111"},
	["T"]={"111","010","010","010","010"},
	["U"]={"101","101","101","101","111"},
	["!"]={"010","010","010","000","010"},
	[" "]={"000","000","000","000","000"},
}

local function MakeTextRGBFrame(Message,Fg,Bg)
	Fg=Fg or Color3.fromRGB(255,80,80)
	Bg=Bg or Color3.fromRGB(10,10,12)
	local Pixels=table.create(TOTAL_BLOCKS)
	for i=1,TOTAL_BLOCKS do
		Pixels[i]=Bg
	end

	local Msg=string.upper(tostring(Message or ""))
	-- skala auto biar muat horizontal
	local Scale=math.max(1,math.floor(math.min(X_SIZE,Y_SIZE)/12))
	local function Measure(S,Sc)
		return #S*((3*Sc)+Sc)-Sc,5*Sc
	end
	local TotalW,GlyphH=Measure(Msg,Scale)
	while Scale>1 and (TotalW>X_SIZE-2 or GlyphH>Y_SIZE-2) do
		Scale-=1
		TotalW,GlyphH=Measure(Msg,Scale)
	end
	-- masih overflow → potong pesan
	while #Msg>1 and TotalW>X_SIZE-2 do
		Msg=Msg:sub(1,#Msg-1)
		TotalW,GlyphH=Measure(Msg,Scale)
	end

	local GlyphW=3*Scale
	local Gap=Scale
	local StartX=math.floor((X_SIZE-TotalW)/2)
	local StartY=math.floor((Y_SIZE-GlyphH)/2)

	for Gi=1,#Msg do
		local Ch=Msg:sub(Gi,Gi)
		local Glyph=BITMAP_GLYPHS[Ch] or BITMAP_GLYPHS[" "]
		local Ox=StartX+(Gi-1)*(GlyphW+Gap)
		for Row=1,5 do
			local Bits=Glyph[Row] or "000"
			for Col=1,3 do
				if Bits:sub(Col,Col)=="1" then
					for Sy=0,Scale-1 do
						for Sx=0,Scale-1 do
							local X=Ox+(Col-1)*Scale+Sx
							local Ytop=StartY+(Row-1)*Scale+Sy
							if X>=0 and X<X_SIZE and Ytop>=0 and Ytop<Y_SIZE then
								Pixels[Ytop*X_SIZE+X+1]=Fg
							end
						end
					end
				end
			end
		end
	end
	return Pixels
end

